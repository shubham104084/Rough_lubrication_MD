# SYSTEM definition
boundary p p f
units metal
atom_style full

#read_data ../step_1_config_gen/config.data
#read_data equil_out_spring.data extra/bond/per/atom 2 extra/angle/per/atom 1  extra/special/per/atom 6
#step_3_1_passsiv_eq_water_spring_2#
#step_3_1_passsiv_eq_water_spring_
#step_3_1_passsiv_eq_water_spring_2_150MPa 2
read_restart restarts/restart.passiv_final

#balance 1.1 shift xyz 20 1.0
#neighbor 1.0 bin 
#neigh_modify delay 1 check yes exclude type 3 4 # To switch off the interaction between real and pseudo atoms
#comm_modify cutoff 10.0

#write_data equil_vel.data pair ij
#XX


# INTERACTIONS
# 1-4: Cu
# 5 : C
# 6 : H
#pair_style hybrid eam/alloy lj/cut 3.0
special_bonds   lj/coul 0 0 1 
#special_bonds   lj/coul 0 0 0.5

pair_style hybrid lj/cut/tip4p/long 5 6 2 1 0.1546 10.0 eam/alloy
kspace_style pppm/tip4p 1e-4

#pair_style hybrid lj/cut/coul/long 12.0 eam/alloy
#kspace_style pppm 1e-5
#kspace_style pppm/tip4p  1.0e-4 #1.0e-5
#kspace_modify gewald 
kspace_modify slab 3.0
#pair_style eam/alloy
pair_coeff * * eam/alloy ../../params/Cu_mishin1.eam.alloy Cu Cu Cu Cu NULL NULL
pair_coeff 5 5 lj/cut/tip4p/long 0.008 3.1589 # O-O
pair_coeff 6 6 lj/cut/tip4p/long 0.0 0.0      # H-H
pair_coeff 5 6 lj/cut/tip4p/long 0.0 0.9572   # O-H
pair_coeff 1 5 lj/cut/tip4p/long 0.0405 2.8875  # H2O-Cu  #0.4 2.86645
pair_coeff 2 5 lj/cut/tip4p/long 0.0405 2.8875  # H2O-Cu
pair_coeff 3 5 lj/cut/tip4p/long 0.0405 2.8875  # H2O-Cu
pair_coeff 4 5 lj/cut/tip4p/long 0.0405 2.8875  # H2O-Cu
pair_coeff 1 6 none
pair_coeff 2 6 none
pair_coeff 3 6 none
pair_coeff 4 6 none


#pair_coeff * * eam/alloy ../params/Cu_mishin1.eam.alloy NULL NULL NULL Cu
#pair_coeff 1 2 lj/cut 0.0103 3.405 3.0
#pair_coeff 3 4 harmonic/cut 2.0 20.0

#
# Setting up water
#molecule DoD_mol ../../params/n_dodecane_opls2.mol toff 4 boff 1
molecule H2O_mol ../params/H2OMol.txt toff 4 boff 1


bond_style harmonic 
bond_coeff 1 2.2e-2 20.0 # Cu- Cu(Pseudo)
bond_coeff 2 0 0.9572    # O_H


angle_style harmonic
angle_coeff 1 0 104.52   # H-O-H


#balance 1.1 shift xyz 20 1.0
# VARIABLES
variable dump_dir string dumps
variable runs equal 2e4
variable dt equal 2e-3
#variable indent_rate equal 0.01  #  unit is 100 m/s

#variable speed_top equal -0.5*${indent_rate}
#variable speed_bot equal 0.5*${indent_rate}


# SHELL COMMANDS
shell mkdir ${dump_dir}
shell mkdir restarts

# PARAMS
timestep ${dt}

#velocity all create 300.0 4928459 rot yes mom yes dist gaussian


variable indent_rate equal -0.5  #  unit is 100 m/s
variable speed_top equal 0.5*${indent_rate}
variable speed_bot equal -0.5*${indent_rate}
#fix top_move top_slab move linear 0.0 0.0 ${speed_top} # ${indent_rate}
#fix bot_fix bot_slab move linear 0.0 0.0 ${speed_bot}
#fix top_layer_move top_layer move linear 0.0 0.0 NULL # ${indent_rate}
#fix bot_layer_move bot_layer move linear 0.0 0.0 NULL

group indenter type 1
group substrate type 2

group top_sum union top_slab top_layer
#group O delete #clear
#group H delete #clear
#group H2O delete #clear
#group O type 5
#group H type 6
#group H2O union O H
region top_thermo block INF INF INF INF 77.5 INF
region bot_thermo block INF INF INF INF INF -79.3
#region for_thermo union 2 top_thermo bot_thermo
group top_thermo_a region top_thermo
group top_thermo intersect top_thermo_a indenter

group bot_thermo_a region bot_thermo
group bot_thermo intersect bot_thermo_a substrate


#region for_thermo union 2 top_thermo bot_thermo
#group for_thermo region for_thermo
group thermo_cu union top_thermo bot_thermo


###################


#fix shakeW CH shake 1.0e-6 200 0 b 3 
fix shakeW OH shake 1.0e-6 200 0 b 2 a 1 mol H2O_mol

fix top_fix top_slab move linear 0.0 0.0 0.0 
fix bot_fix2 bot_slab move linear 0.0 0.0 0.0
fix top_layer_fix2 top_layer move linear 0.0 0.0 NULL # ${indent_rate}
fix bot_layer_fix2 bot_layer move linear 0.0 0.0 NULL


#fix bot_fix bot_layer setforce 0.0 0.0 0.0
#fix freeze indenter setforce 0.0 0.0 0.0

#fix 3 all print 100 "${msxx} ${msyy} ${mszz}" file stress.dat screen no

#fix 1 all press/langevin temp 300 300 395724215 x 0.0 0.0 2.0 y 0.0 0.0 2.0
#fix 2 all langevin 300 300 2.0 4032548 zero yes gjf vfull
#fix 3 all nve
#velocity H2O set 0.0 0.0 0.0 sum yes mom yes rot yes units box

#velocity H2O create 300.0 4928459 rot yes mom yes dist gaussian loop geom

#fix 1 all press/langevin temp 300 300 395724215 x 0.0 0.0 5.0 y 0.0 0.0 5.0 # couple xy
#fix 2 mobile gjf 300 300 1.0 4032548 vel vhalf method 8
#fix 2 mobile langevin 0.1 0.10 1.0 4032548 zero yes gjf vfull
#fix int mobile nve #/limit 0.01
#fix 2 nonrigid gjf 300 300 1.0 4032548 vel vhalf method 8

fix cu_thermo thermo_cu langevin 300.0 300.0 1.0 4032548 gjf vfull

compute myTemp thermo_cu temp/partial 0 1 0
fix_modify cu_thermo temp myTemp
fix mynve mobile nve
#fix int_top top_layer nve
#fix int_bot bot_layer nve

#fix file all print 100 "${msxx} ${msyy} ${mszz}" file stress.dat screen no

#variable fz equal f_top_move

compute Flayer top_layer group/group indenter
variable fxl equal c_Flayer[1]
variable fyl equal c_Flayer[2]
variable fzl equal c_Flayer[3]

compute Flayert top_layer reduce sum fx fy fz
variable fxlt equal c_Flayert[1]
variable fylt equal c_Flayert[2]
variable fzlt equal c_Flayert[3]

compute Ftop top_slab reduce sum fx fy fz
variable fx equal c_Ftop[1]
variable fy equal c_Ftop[2]
variable fz equal c_Ftop[3]

compute Ftsum top_sum reduce sum fx fy fz
variable fxs equal c_Ftsum[1]
variable fys equal c_Ftsum[2]
variable fzs equal c_Ftsum[3]

compute Pos_top top_slab reduce ave x y z
variable Px equal c_Pos_top[1]
variable Py equal c_Pos_top[2]
variable Pz equal c_Pos_top[3]

variable step0 equal step
variable indent equal (step-${step0})*(${indent_rate})*${dt}

thermo_style custom step v_indent temp c_myTemp pe press pxx pyy pzz v_fx v_fy v_fz v_Pz v_fxl v_fyl v_fzl v_fxs v_fys v_fzs v_fxlt v_fylt v_fzlt
thermo 1000
# FIXES
compute	p all stress/atom myTemp
compute vpa all voronoi/atom
variable	sxx atom "c_p[1] / c_vpa[1]"
variable	syy atom "c_p[2] / c_vpa[1]"
variable	szz atom "c_p[3] / c_vpa[1]"
variable	sxy atom "c_p[4] / c_vpa[1]"
variable	sxz atom "c_p[5] / c_vpa[1]"
variable	syz atom "c_p[6] / c_vpa[1]"
variable vonMises atom "sqrt((v_sxx-v_syy)^2+(v_syy-v_szz)^2+(v_szz-v_sxx)^2+6*(v_sxy^2+v_sxz^2+v_syz^2))/sqrt(2)"

fix aveStress all ave/atom 20 100 2000 v_sxx v_syy v_szz v_sxy v_sxz v_syz v_vonMises
fix aveforce all ave/time 1 5000 5000 c_Flayert[1] c_Flayert[2] c_Ftop[3]

variable        favgx equal "f_aveforce[1]"
variable        favgy equal "f_aveforce[2]"
variable        favgz equal "f_aveforce[3]"



#fix aveStress all ave/atom 5 10 500 c_p[*]
#fix aveVM all ave/atom 

#variable fz f_top_move[1]

compute mean_sxx all reduce ave v_sxx
compute mean_syy all reduce ave v_syy
compute mean_szz all reduce ave v_szz
variable msxx equal c_mean_sxx
variable msyy equal c_mean_syy
variable mszz equal c_mean_szz

#fix 3 all 
#fix 3 all print 100 "$x $y $z" file coord.txt
fix          data    all print 5000 "${indent} ${Px} ${Py} ${Pz} ${fxlt} ${fylt} ${fz} ${favgx} ${favgy} ${favgz}" file force_displacement.dat screen no



fix aveforce2 all ave/time 1 1000 1000 c_Flayert[1] c_Flayert[2] c_Ftop[3]
variable        favgx2 equal "f_aveforce2[1]"
variable        favgy2 equal "f_aveforce2[2]"
variable        favgz2 equal "f_aveforce2[3]"

fix          data2    all print 1000 "${indent} ${Px} ${Py} ${Pz} ${fxlt} ${fylt} ${fz} ${favgx2} ${favgy2} ${favgz2}" file force_displacement2.dat screen no





# DUMPING
dump	1 all custom 20000 ${dump_dir}/dump_preslide.lammpstrj id mol type x y z vx vy vz fx fy fz v_vonMises f_aveStress[1] f_aveStress[2] f_aveStress[3] f_aveStress[4] f_aveStress[5] f_aveStress[6] f_aveStress[7] c_vpa[1] c_vpa[2]

run 50000

undump 1
unfix top_fix
unfix bot_fix2
unfix top_layer_fix2
unfix bot_layer_fix2

write_data passivated.data
write_restart restarts/restart.passive_final


XX

variable step00 equal step
variable indent0 equal (step-${step00})*(${indent_rate})*${dt}

thermo_style custom step v_indent0 temp c_myTemp pe press pxx pyy pzz v_fx v_fy v_fz v_Pz v_fxl v_fyl v_fzl v_fxs v_fys v_fzs v_fxlt v_fylt v_fzlt
thermo 1000

fix top_move top_slab move linear ${speed_top} 0.0 0.0
fix bot_fix bot_slab move linear ${speed_bot} 0.0 0.0
fix top_layer_move top_layer move linear ${speed_top} 0.0 NULL # ${indent_rate}
fix bot_layer_move bot_layer move linear ${speed_bot} 0.0 NULL
restart 20000 restarts/restart.*.slide

dump    1 all custom 20000 ${dump_dir}/dump_slide.lammpstrj id mol type x y z vx vy vz fx fy fz v_vonMises f_aveStress[1] f_aveStress[2] f_aveStress[3] f_aveStress[4] f_aveStress[5] f_aveStress[6] f_aveStress[7] c_vpa[1] c_vpa[2]

fix          data    all print 5000 "${indent0} ${Px} ${Py} ${Pz} ${fxlt} ${fylt} ${fz} ${favgx} ${favgy} ${favgz}" file force_displacement.dat screen no

fix          data2    all print 1000 "${indent0} ${Px} ${Py} ${Pz} ${fxlt} ${fylt} ${fz} ${favgx2} ${favgy2} ${favgz2}" file force_displacement2.dat screen no


#dump_modify	1 sort id units yes
#dump    1 all custom 500 ${dump_dir}/dump.lammpstrj id mol type x y z v_vonMises v_sxx[1] v_syy[2] v_szz[3] v_sxy[4] v_sxz[5] v_syz[6] c_vpa[1] c_vpa[2]

# RUN
#run 50000

# write out last config
#write_data barostatted_out.data
#write_restart restart_baro.equil

#undump 1
#unfix 1

#dump    1 all custom 5000 ${dump_dir}/dump_equil.lammpstrj id mol type x y z v_vonMises f_aveStress[1] f_aveStress[2] f_aveStress[3] f_aveStress[4] f_aveStress[5] f_aveStress[6] f_aveStress[7] c_vpa[1] c_vpa[2]

## Affine displacement of indenter before start
#displace_atoms indenter move 0 0 -15 units box

#run 4000
#run 500000
#write_data test.data 
run 2500000

#variable indent_rate equal 0.01  #  unit is 100 m/s
#variable speed_top equal -0.5*${indent_rate}
#variable speed_bot equal 0.5*${indent_rate}
