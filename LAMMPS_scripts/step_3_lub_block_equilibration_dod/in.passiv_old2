# SYSTEM definition
#boundary p p f
#units metal
#atom_style full

#read_data ../step_1_config_gen/config.data
#read_data equil_out_spring.data extra/bond/per/atom 4 extra/angle/per/atom 8 extra/dihedral/per/atom 16 extra/special/per/atom 64
#read_restart restart.adsorbed
#read_restart restarts/restart.50000.adsorb
read_restart restart.adsorbed

#read_restart restarts/restart.76000.adsorb
#balance 1.1 shift xyz 20 1.0
#neighbor 1.0 bin 
#neigh_modify delay 1 check yes exclude type 3 4 # To switch off the interaction between real and pseudo atoms
#comm_modify cutoff 10.0

#write_data equil_vel.data pair ij
#XX


# INTERACTIONS
# 1-4: Cu
# 5 : O
# 6 : H
#pair_style hybrid eam/alloy lj/cut 3.0
special_bonds   lj/coul 0 0 0.5 

#pair_style hybrid lj/cut 12.0 eam/alloy
pair_style hybrid lj/cut/coul/long 12.0 eam/alloy
kspace_style pppm 1e-5
#kspace_style pppm/tip4p  1.0e-4 #1.0e-5
#kspace_modify gewald 
kspace_modify slab 3.0
#pair_style eam/alloy
pair_coeff * * eam/alloy ../../params/Cu_mishin1.eam.alloy Cu Cu Cu Cu NULL NULL
pair_coeff 5 5 lj/cut/coul/long 0.00290539571 3.5 # C-C
pair_coeff 6 6 lj/cut/coul/long 0.00130092345 2.5 # H-H
pair_coeff 5 6 lj/cut/coul/long 0.00194414439 3.0 # C-H
pair_coeff 1 5 lj/cut/coul/long 0.02438598766 3.058 # Cu-C
pair_coeff 2 5 lj/cut/coul/long 0.02438598766 2.9185 # Cu-C
pair_coeff 3 5 lj/cut/coul/long 0.02438598766 2.9185 # Cu-C
pair_coeff 4 5 lj/cut/coul/long 0.02438598766 2.9185 # Cu-C
pair_coeff 1 6 lj/cut/coul/long 0.016317873996 2.558  # Cu-H
pair_coeff 2 6 lj/cut/coul/long 0.016317873996 2.4185  # Cu-H
pair_coeff 3 6 lj/cut/coul/long 0.016317873996 2.4185  # Cu-H
pair_coeff 4 6 lj/cut/coul/long 0.016317873996 2.4185  # Cu-H

###########################
#group top delete
#group bot delete
#region top block INF INF INF INF 0.0 INF
#region bot block INF INF INF INF INF 0.0
#group top region top
#group bot region bot

#write_data adsorbed.data nocoeff

#displace_atoms top move 0.0 0.0 -90.0 units box
#displace_atoms bot move 0.0 0.0 90.0 units box 

#write_data adsorbed_disp.data nocoeff
