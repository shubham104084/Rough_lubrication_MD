#XX
############################
#pair_coeff * * eam/alloy ../params/Cu_mishin1.eam.alloy NULL NULL NULL Cu
#pair_coeff 1 2 lj/cut 0.0103 3.405 3.0
#pair_coeff 3 4 harmonic/cut 2.0 20.0

#
# Setting up water
#molecule H2O_mol ../params/H2OMol.txt toff 4 boff 1
molecule DoD_mol ../../params/n_dodecane_opls2.mol toff 4 boff 1
#DOD ../params/n_dodecane_opls.mol

# Value source: J. Am. Chem. Soc. 1996, 118, 45, 11225–11236
bond_style harmonic
bond_coeff 1 2.2e-2 20.0 # Cu- Cu(Pseudo)
bond_coeff 2   11.6216 1.529   #13.443  1.529   # CT-CT
bond_coeff 3   14.7438 1.090  #14.744  1.090   # CT-HC

angle_style harmonic
angle_coeff 1   1.4310 107.8   # 1.4310   107.8   # H-C-H
angle_coeff 2   2.5368 112.7   #2.7319   112.7   # C-C-C
angle_coeff 3   1.6262 110.7   #1.5177   110.7   # C-C-H

dihedral_style  opls
dihedral_coeff 1  0.0754535 -0.00680816  0.0120986 0.000  # C-C-C-C
dihedral_coeff 2  0.0000000  0.00000000  0.0158713 0.000  # C-C-C-H
dihedral_coeff 3  0.0000000  0.00000000  0.0137898  0.000  # H-C-C-H



#balance 1.1 shift xyz 20 1.0
# VARIABLES
variable dump_dir string dumps
variable runs equal 2e4
variable dt equal 2e-3
variable indent_rate equal 0.1  #  unit is 100 m/s

variable speed_top equal -0.5*${indent_rate}
variable speed_bot equal 0.5*${indent_rate}


# SHELL COMMANDS
shell mkdir ${dump_dir}
shell mkdir restarts

# PARAMS
timestep ${dt}

#velocity all create 300.0 4928459 rot yes mom yes dist gaussian

## Region for freezing and integration
#region top_freeze block INF INF INF INF 92.0 INF
#region bot_freeze block INF INF INF INF INF -93.6
#region freeze union 2 top_freeze bot_freeze

#region top block INF INF INF INF 0.0 INF
#region bot block INF INF INF INF INF 0.0
#region h2o block INF INF INF INF -3.0 23.0
#region h2o block INF INF INF INF -59.0 54.0

#region h2o block 0.0 500.0 0.0 15.625 -4.0 4.0    # 15.625
#region h2o block 1.0 499.0 0.1 17.0 20.0 40.0    # 15.6252

#region h2o block 5.0 495.0 0.1 17.2 20.0 40.0
#region DoDb1 block 5.0 125.0 0.1 17.6 -120.0 -75.0 #74.0
#region DoDb2 block 135.0 195.0 0.1 17.6 -120.0 -55.0 #74.0
#region DoDb3 block 205.0 225.0 0.1 17.6 -150.0 -45.0 #74.0
#region DoDb4 block 225.0 305.0 0.1 17.6 -150.0 -5.0 #74.0
#region DoDb5 block 315.0 345.0 0.1 17.6 -130.0 -25.0 #74.0
#region DoDb6 block 345.0 385.0 0.1 17.6 -130.0 -45.0
#region DoDb7 block 385.0 495.0 0.1 17.6 -130.0 -35.0
#region DoDb union 7 DoDb1 DoDb2 DoDb3 DoDb4 DoDb5 DoDb6 DoDb7

#region DoDu1 block 5.0 75.0 0.1 17.6 -10.0 155.0
#region DoDu2 block 75.0 185.0 0.1 17.6 60.0 135.0
#region DoDu3 block 245.0 285.0 0.1 17.6 80.0 120.0
#region DoDu4 block 285.0 345.0 0.1 17.6 50.0 120.0
#region DoDu5 block 350.0 400.0 0.1 17.6 -5.0 135.0
#region DoDu6 block 420.0 490.0 0.1 17.6 0.0 155.0
#region DoDu union 6 DoDu1 DoDu2 DoDu3 DoDu4 DoDu5 DoDu6

#region DoD union 2 DoDu DoDb


#region h2o block INF INF INF INF -4.0 4.0
 

#lattice sc 10.0 # 18.0 #3.5

#variable    Nw equal 10 #1000              # <-- choose how many you want
#create_atoms 0 random ${Nw} 928374 h2o mol H2O_mol 473829 overlap 2.0 maxtry 100000
#create_atoms 0 region DoD mol DoD_mol 473829 rotate 50 0 0 1

#write_data init_data.dat

#group top region top
#group bot region bot
#group typ1 type 1
#group typ2 type 2
#group typ3 type 3
#group typ4 type 4
#group C type 5
#group H type 6
#group CH union C H

#delete_atoms overlap 3.6 CH typ1 mol yes bond yes
#delete_atoms overlap 3.6 CH typ2 mol yes bond yes

#write_data init.data nocoeff

#XX

#group C clear
#group H clear
#group CH clear
#group C type 5
#group H type 6
#group CH union C H

#group top_1 region DoDu
#group bot_1 region DoDb
#group top_mol intersect top_1 CH
#group bot_mol intersect bot_1 CH



#group top_slab intersect top typ4
#group bot_slab intersect bot typ4
#group top_layer intersect top typ3
#group bot_layer intersect bot typ3

#group slab union top_slab bot_slab
#group layer union top_layer bot_layer

#group frozen region freeze
#group mobile subtract all frozen
#group nonrigid subtract all slab 
#group mobile subtract all slab layer

#displace_atoms top move 0 0 -50 units box
#displace_atoms bot move 0 0 50 units box

fix shakeW CH shake 1.0e-6 200 0 b 3 # mol yes # H2O_mol

fix top_move1 top_slab move linear 0.0 0.0 ${speed_top}
fix bot_fix1 bot_slab move linear 0.0 0.0 ${speed_bot}
fix top_layer_move top_layer move linear 0.0 0.0 NULL # ${indent_rate}
fix bot_layer_move bot_layer move linear 0.0 0.0 NULL

#fix gu top_mol gravity 9.81e-5 vector 0.0 0.0 1.0    # 9.81e-14
#fix gb bot_mol gravity 9.81e-5 vector 0.0 0.0 -1.0
#fix bot_fix bot_layer setforce 0.0 0.0 0.0
#fix freeze indenter setforce 0.0 0.0 0.0

#fix 3 all print 100 "${msxx} ${msyy} ${mszz}" file stress.dat screen no

#fix 1 all press/langevin temp 300 300 395724215 x 0.0 0.0 2.0 y 0.0 0.0 2.0
#fix 2 all langevin 300 300 2.0 4032548 zero yes gjf vfull
#fix 3 all nve
#velocity H2O set 0.0 0.0 0.0 sum yes mom yes rot yes units box

#velocity CH create 300.0 4928459 rot yes mom yes dist gaussian loop geom

#fix 1 all press/langevin temp 300 300 395724215 x 0.0 0.0 5.0 y 0.0 0.0 5.0 # couple xy
#fix 2 nonrigid gjf 300 300 1.0 4032548 vel vhalf method 8
#fix 2 mobile langevin 0.1 0.10 1.0 4032548 zero yes gjf vfull
#fix int mobile nve #/limit 0.01
#fix 2 nonrigid gjf 300 300 1.0 4032548 vel vhalf method 8
#compute myTemp mobile temp #/partial 1 1 0
#fix_modify 2 temp myTemp

#group cu_mobile subtract mobile CH

fix cu_thermo mobile langevin 300.0 300.0 1.0 4032548 gjf vfull

compute myTemp mobile temp/partial 1 1 0
fix_modify cu_thermo temp myTemp
#fix mynve mobile nve
fix mynve cu_mobile nve
fix mynve0 CH nve/limit 0.1

#fix cu_thermo mobile langevin 300.0 300.0 1.0 4032548 gjf vfull


#fix int_top top_layer nve
#fix int_bot bot_layer nve

#fix file all print 100 "${msxx} ${msyy} ${mszz}" file stress.dat screen no

#variable fz equal f_top_move


compute Ftop top_slab reduce sum fx fy fz
variable fx equal c_Ftop[1]
variable fy equal c_Ftop[2]
variable fz equal c_Ftop[3]

compute Pos_top top_slab reduce ave x y z
variable Px equal c_Pos_top[1]
variable Py equal c_Pos_top[2]
variable Pz equal c_Pos_top[3]

variable indent equal step*(-${indent_rate})*${dt}

thermo_style custom step temp c_myTemp pe press pxx pyy pzz v_fx v_fy v_fz v_Pz fmax fnorm v_indent
thermo 100
# FIXES
#compute	p all stress/atom myTemp
#compute vpa all voronoi/atom
#variable	sxx atom "c_p[1] / c_vpa[1]"
#variable	syy atom "c_p[2] / c_vpa[1]"
